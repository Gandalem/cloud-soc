ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# Secure central ES (choose API key OR username/password; never both):
# ELASTICSEARCH_URL=https://your-private-es:9200
# ELASTICSEARCH_CA_FILE=/absolute/path/ca.crt
# ELASTICSEARCH_API_KEY_FILE=/absolute/path/detector.key
# Credential files need mode 0600 on POSIX.
# SOC_USERS_FILE enables optional portal sessions; see docs/improvements_1_12.md.
