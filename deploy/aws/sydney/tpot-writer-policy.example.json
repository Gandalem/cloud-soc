{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::replace-with-existing-sydney-log-bucket"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::replace-with-existing-sydney-log-bucket/tpot/team-a/cowrie/*",
        "arn:aws:s3:::replace-with-existing-sydney-log-bucket/tpot/team-a/suricata/*"
      ]
    }
  ]
}
