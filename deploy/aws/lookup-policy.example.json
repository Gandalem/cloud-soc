{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadManagementEventHistoryInApprovedRegions",
      "Effect": "Allow",
      "Action": "cloudtrail:LookupEvents",
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": ["ap-northeast-1", "us-east-1"]}}
    }
  ]
}
