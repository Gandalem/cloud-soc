{
  "packetbeat-9.5.2-amqp": {
    "description": "Pipeline for processing amqp traffic",
    "on_failure": [
      {
        "append": {
          "field": "error.message",
          "value": "Processor \"{{ _ingest.on_failure_processor_type }}\" with tag \"{{ _ingest.on_failure_processor_tag }}\" in pipeline \"{{ _ingest.on_failure_pipeline }}\" failed with message \"{{ _ingest.on_failure_message }}\""
        }
      },
      {
        "set": {
          "field": "event.kind",
          "value": "pipeline_error"
        }
      }
    ],
    "processors": [
      {
        "set": {
          "field": "ecs.version",
          "value": "8.11.0"
        }
      },
      {
        "gsub": {
          "field": "host.mac",
          "ignore_missing": true,
          "pattern": "[-:.]",
          "replacement": "",
          "tag": "gsubmac"
        }
      },
      {
        "gsub": {
          "field": "host.mac",
          "ignore_missing": true,
          "pattern": "(..)(?!$)",
          "replacement": "$1-",
          "tag": "gsubmac"
        }
      },
      {
        "uppercase": {
          "field": "host.mac",
          "ignore_missing": true
        }
      },
      {
        "append": {
          "allow_duplicates": false,
          "field": "related.hosts",
          "if": "ctx.observer?.hostname != null && ctx.observer?.hostname != ''",
          "value": "{{{observer.hostname}}}"
        }
      },
      {
        "foreach": {
          "field": "observer.ip",
          "if": "ctx.observer?.ip != null && ctx.observer.ip instanceof List",
          "processor": {
            "append": {
              "allow_duplicates": false,
              "field": "related.ip",
              "value": "{{{_ingest._value}}}"
            }
          },
          "tag": "foreachip"
        }
      },
      {
        "remove": {
          "field": "host",
          "if": "ctx.host != null && ctx.tags != null && ctx.tags.contains('forwarded')"
        }
      },
      {
        "pipeline": {
          "if": "ctx._conf?.geoip_enrich != null && ctx._conf.geoip_enrich",
          "name": "{{ IngestPipeline \"geoip\" }}",
          "tag": "pipelineprocessor"
        }
      },
      {
        "remove": {
          "field": "_conf",
          "ignore_missing": true
        }
      }
    ]
  },
