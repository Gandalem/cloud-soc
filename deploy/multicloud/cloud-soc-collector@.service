[Unit]
Description=Cloud SOC multicloud audit collector %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=cloud-soc
Group=cloud-soc
WorkingDirectory=/opt/cloud-soc
EnvironmentFile=/etc/cloud-soc/multicloud.env
ExecStart=/opt/cloud-soc/.venv/bin/python -m cloud_soc.multicloud collect --config /etc/cloud-soc/multicloud.json --source %i --state-dir /var/lib/cloud-soc/multicloud
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cloud-soc/multicloud

[Install]
WantedBy=multi-user.target
