@@ -0,0 +1,19 @@
+rules:
+  - id: AUTH-SEQ-001
+    type: sequence
+    name: SSH repeated failures followed by successful authentication
+    enabled: true
+    severity: high
+    group_by: [organization.id, host.id, user.name, source.ip]
+    threshold: {count: 5}
+    time_window: {seconds: 300}
+    cooldown: {seconds: 0}
+    conditions:
+      - {field: event.category, operator: contains, value: authentication}
+      - {field: network.protocol, operator: equals, value: ssh}
+      - {field: event.outcome, operator: in, value: [failure, success]}
+    alert:
+      title: 반복 SSH 인증 실패 후 성공
